<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>Maui.AppIntents</PackageId>
    <Title>.NET MAUI App Intents</Title>
    <Description>C# authoring API and build integration for generated Swift App Intents in .NET MAUI iOS apps.</Description>
    <Authors>Redth</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maui.AppIntents.Generator\Maui.AppIntents.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\Maui.AppIntents.BuildTasks\Maui.AppIntents.BuildTasks.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive\**\*" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <Target Name="_IncludeMauiAppIntentsBuildAssets" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="..\Maui.AppIntents.Generator\bin\$(Configuration)\netstandard2.0\Maui.AppIntents.Generator.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs/"
            Condition="Exists('..\Maui.AppIntents.Generator\bin\$(Configuration)\netstandard2.0\Maui.AppIntents.Generator.dll')" />
      <None Include="..\Maui.AppIntents.BuildTasks\bin\$(Configuration)\netstandard2.0\**\*"
            Pack="true"
            PackagePath="tasks/"
            Exclude="..\Maui.AppIntents.BuildTasks\bin\$(Configuration)\netstandard2.0\Microsoft.Build.*;..\Maui.AppIntents.BuildTasks\bin\$(Configuration)\netstandard2.0\*.pdb"
            Condition="Exists('..\Maui.AppIntents.BuildTasks\bin\$(Configuration)\netstandard2.0\Maui.AppIntents.BuildTasks.dll')" />
    </ItemGroup>
  </Target>
</Project>
