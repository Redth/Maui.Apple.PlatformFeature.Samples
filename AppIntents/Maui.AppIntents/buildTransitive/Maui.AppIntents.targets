");
    }

    private static string SwiftType(Parameter parameter)
    {
        var type = NormalizeType(parameter.Type);
        var swift = type == "string" ? "String" :
            type == "int" || type == "nint" || type == "long" ? "Int" :
            type == "double" || type == "float" || type == "decimal" ? "Double" :
            type == "bool" ? "Bool" :
            type == "datetime" || type == "datetimeoffset" ? "Date" :
            "String";
        return parameter.IsOptional ? swift + "?" : swift;
    }

    private static string PayloadExpression(Parameter parameter)
    {
        var type = NormalizeType(parameter.Type);
        if (parameter.IsOptional)
        {
            if (type == "datetime" || type == "datetimeoffset")
            {
                return parameter.SwiftName + ".map { ISO8601DateFormatter().string(from: $0) } ?? NSNull()";
            }
            return parameter.SwiftName + " ?? NSNull()";
        }
        if (type == "datetime" || type == "datetimeoffset")
        {
            return "ISO8601DateFormatter().string(from: " + parameter.SwiftName + ")";
        }
        return parameter.SwiftName;
    }

    private static bool IsNumeric(string type)
    {
        var normalized = NormalizeType(type);
        return normalized == "int" || normalized == "nint" || normalized == "long" || normalized == "double" || normalized == "float" || normalized == "decimal";
    }

    private static string NormalizeType(string type)
    {
        return type.Replace("?", "").Replace("System.", "").Trim().ToLowerInvariant();
    }

    private static string SanitizeIdentifier(string value)
    {
        var chars = value.Where(char.IsLetterOrDigit).ToArray();
        return chars.Length == 0 ? "GeneratedIntent" : new string(chars);
    }

    private static string LowerFirst(string value)
    {
        if (string.IsNullOrEmpty(value)) return value;
        return char.ToLowerInvariant(value[0]) + value.Substring(1);
    }

    private static string SplitWords(string value)
    {
        return Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");
    }

    private static string EscapeSwift(string value)
    {
        return (value ?? "").Replace("\\", "\\\\").Replace("\"", "\\\"");
    }

    private static string EscapeCSharp(string value)
    {
        return (value ?? "").Replace("\\", "\\\\").Replace("\"", "\\\"");
    }

    private static string EscapeBash(string value)
    {
        return (value ?? "").Replace("\\", "\\\\").Replace("\"", "\\\"");
    }

    private static string FirstString(string args)
    {
        var match = Regex.Match(args ?? "", "\"(?<v>(?:\\\\.|[^\"])*)\"");
        return match.Success ? match.Groups["v"].Value.Replace("\\\"", "\"") : null;
    }

    private static string NamedString(string args, string name)
    {
        var match = Regex.Match(args ?? "", name + "\\s*=\\s*\"(?<v>(?:\\\\.|[^\"])*)\"");
        return match.Success ? match.Groups["v"].Value.Replace("\\\"", "\"") : null;
    }

    private static bool? NamedBool(string args, string name)
    {
        var match = Regex.Match(args ?? "", name + "\\s*=\\s*(?<v>true|false)", RegexOptions.IgnoreCase);
        return match.Success ? bool.Parse(match.Groups["v"].Value) : (bool?)null;
    }

    private static double? NamedDouble(string args, string name)
    {
        var match = Regex.Match(args ?? "", name + "\\s*=\\s*(?<v>-?[0-9]+(?:\\.[0-9]+)?)");
        if (match.Success && double.TryParse(match.Groups["v"].Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            return value;
        }
        return null;
    }
}
